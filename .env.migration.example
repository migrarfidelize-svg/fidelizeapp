# === Supabase DESTINO ===
# Painel: supabase.com → Project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Espelham as VITE_* — necessárias em SSR / server functions
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Painel: Project → Settings → API → service_role  (NUNCA expor no client)
SUPABASE_SERVICE_ROLE_KEY=

# Painel: Project → Settings → Database → Connection string
SUPABASE_DB_URL=

# === Supabase ORIGEM (somente para scripts de migração) ===
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
SOURCE_DB_URL=

# === Web Push (reutilizar da ORIGEM para preservar subscriptions) ===
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@fidelize.app

# === Integrações externas ===
RESEND_API_KEY=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# === Lovable AI (opcional, se seguir usando) ===
LOVABLE_API_KEY=

# === App ===
VITE_APP_URL=https://novo-dominio.exemplo.com
